APP_NAME=ginfoconf
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL of the Next.js frontend (used in email notification links)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ginfoconf
DB_USERNAME=postgres
DB_PASSWORD=secret

# SQLite (for local dev / CI — comment out pgsql block above)
# DB_CONNECTION=sqlite

# ── Sessions & Cache ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ginfoconf.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── File Storage ──────────────────────────────────────────────────────────────
# Manuscript uploads disk: "local" (default) or "s3"
SUBMISSIONS_DISK_DRIVER=local
# Conference media disk: "local" (default) or "s3"
CONFERENCES_DISK_DRIVER=local

# ── AWS S3 (set when using s3 disks) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_SUBMISSIONS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed frontend origins (comma-separated in production)
SANCTUM_STATEFUL_DOMAINS=localhost:3000

VITE_APP_NAME="${APP_NAME}"
